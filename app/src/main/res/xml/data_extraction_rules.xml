<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="models/" />
        <exclude domain="root" path="staging/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="staging/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure-api-credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="models/" />
        <exclude domain="root" path="staging/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="staging/" />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure-api-credentials.xml" />
    </device-transfer>
</data-extraction-rules>
